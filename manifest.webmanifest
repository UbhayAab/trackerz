{
  "name": "Deno",
  "short_name": "Deno",
  "description": "Capture-first life tracker. Money, diet, wellness from voice, text, photos, and bank files.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "theme_color": "#138a5b",
  "background_color": "#f9f8f4",
  "icons": [
    { "src": "./icons/icon-192.svg", "sizes": "192x192", "type": "image/svg+xml", "purpose": "any" },
    { "src": "./icons/icon-512.svg", "sizes": "512x512", "type": "image/svg+xml", "purpose": "any" },
    { "src": "./icons/icon-maskable.svg", "sizes": "512x512", "type": "image/svg+xml", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "./share-target.html",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        { "name": "media", "accept": ["image/*", "audio/*", "text/*", "application/pdf", ".csv", ".xls", ".xlsx"] }
      ]
    }
  },
  "shortcuts": [
    {
      "name": "Log 250 ml water",
      "short_name": "+250 ml",
      "description": "Log one glass of water without opening the app",
      "url": "./quick-log.html?do=water&ml=250",
      "icons": [{ "src": "./icons/icon-192.svg", "sizes": "192x192", "type": "image/svg+xml" }]
    },
    { "name": "Capture", "short_name": "Capture", "description": "Drop text, a photo or your voice into Deno", "url": "./index.html" },
    { "name": "Money", "short_name": "Money", "description": "This month's spend and budget", "url": "./pages/money.html" },
    { "name": "Insights", "short_name": "Insights", "description": "Trends across money, diet and wellness", "url": "./pages/analytics.html" }
  ],
  "categories": ["finance", "lifestyle", "productivity", "health"]
}
