<?xml version="1.0" encoding="utf-8"?>
<!--
  The widget card. A plain shape drawable rather than
  @android:dimen/system_app_widget_background_radius, which only exists from API
  31 and would fail to resolve on anything older - this project's floor is 26.

  16dp is what Android 12's own widget corner radius lands on, so it sits with
  the system widgets instead of looking like a rectangle glued to the wallpaper.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/water_widget_bg" />
    <corners android:radius="16dp" />
    <stroke
        android:width="1dp"
        android:color="@color/water_widget_line" />
</shape>
