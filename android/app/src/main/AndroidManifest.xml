<?xml version="1.0" encoding="utf-8"?>
<!--
  AndroidManifest for the Trackerz Capacitor shell.

  UNTESTED ON HARDWARE.

  The Health Connect permissions below are the WHOLE reason this native shell
  exists - a browser can never hold them. They must exactly match
  HealthConnectPlugin.READ_PERMISSIONS; asking for a permission the plugin does
  not read is a privacy smell and can fail Play review.

  Health Connect also demands that the app expose a privacy-policy screen it can
  deep-link into, or it refuses to show the permission sheet at all. That is the
  HealthPrivacyPolicyActivity + the two intent filters near the bottom (one for
  Android 13-, one for Android 14+). Leaving them out makes the permission
  request look, to the user, exactly like a denial.

  NOTE: `npx cap sync` / `cap add android` will regenerate a stock version of
  this file and drop everything Health-Connect-specific. If that happens, restore
  the four Health blocks below: the <uses-permission android.permission.health.*>
  lines, the <queries> block, the ViewPermissionUsageActivity alias, and the
  HealthPrivacyPolicyActivity. The GitHub Actions workflow copies this file back
  into place after sync for exactly this reason.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Health Connect READ permissions. Keep in sync with HealthConnectPlugin.READ_PERMISSIONS. -->
    <uses-permission android:name="android.permission.health.READ_SLEEP" />
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <uses-permission android:name="android.permission.health.READ_HYDRATION" />
    <uses-permission android:name="android.permission.health.READ_TOTAL_CALORIES_BURNED" />
    <uses-permission android:name="android.permission.health.READ_ACTIVE_CALORIES_BURNED" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" />

    <!-- The web app loads its own DB library and talks to Supabase over HTTPS. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      SMS read + receive: auto-capture UPI/bank spend from transaction SMS. There is
      no public GPay/UPI API; the bank SMS every payment triggers is the only device
      -side signal, so SmsReaderPlugin reads it and feeds it to the capture pipeline.
      These are Play-restricted permissions - fine for this personal sideloaded debug
      APK. `npx cap sync` may drop these; the CI workflow restores this file.
    -->
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.RECEIVE_SMS" />

    <!--
      MICROPHONE. Without these, voice capture is not merely degraded in the APK -
      it is impossible. Capacitor's BridgeWebChromeClient.onPermissionRequest maps
      the WebView's RESOURCE_AUDIO_CAPTURE onto RECORD_AUDIO + MODIFY_AUDIO_SETTINGS
      and requests them; Android returns PERMISSION_DENIED instantly, with no
      dialog, for any permission the manifest does not declare. So getUserMedia
      rejected immediately and the old bare `catch {}` in capture-panel.js swallowed
      the reason, which is why voice "just did nothing" on the phone.

      MODIFY_AUDIO_SETTINGS is not optional padding: Capacitor requests the pair,
      and without it the audio subsystem can still refuse the mic after the user
      has tapped Allow.
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!--
      CAMERA for the in-app capture chip. Declared not-required so the app still
      installs on a device without one.
    -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!--
      POST_NOTIFICATIONS (Android 13+). Every reminder and every proactive brief
      goes through the system notification manager, so without this the whole
      proactive engine is silent on the phone and indistinguishable from "nothing
      was due".
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Scheduled local reminders must survive a reboot. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
      Lets the app see and deep-link the Health Connect provider. On Android 11+
      this <queries> block is required even to check whether the package exists.

      The RecognitionService intent is the same rule applied to speech: on API 30+
      an app cannot see the on-device recognizer package unless it declares it
      here, so SpeechRecognizer.isRecognitionAvailable() returns false and native
      dictation silently reports "unsupported" on a phone that supports it fine.
    -->
    <queries>
        <package android:name="com.google.android.apps.healthdata" />
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!--
          Privacy-policy screen Health Connect requires. exported=true because a
          different process (the Health Connect app / the platform) launches it.

          This <activity> MUST be declared before the <activity-alias> below -
          Android requires an alias's targetActivity to appear earlier in the
          manifest.

          Filter - Android 13 and below: Health Connect fires this action.
        -->
        <activity
            android:name=".health.HealthPrivacyPolicyActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>

        <!--
          Alias - Android 14+: the platform routes the health-permission rationale
          here via VIEW_PERMISSION_USAGE + the HEALTH_PERMISSIONS category. Guarded
          by START_VIEW_PERMISSION_USAGE so only the system can launch it.
        -->
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:targetActivity=".health.HealthPrivacyPolicyActivity"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

        <!--
          Passive spend capture: the notification listener that reads payment/bank
          notifications (GPay "You paid Rs 250 to Zepto", bank alerts) so spend is
          logged no matter where the payment started. The user grants access once in
          Settings -> Notification access; BIND_NOTIFICATION_LISTENER_SERVICE is held
          by the system, not requested at runtime. `npx cap sync` may drop this; the
          CI workflow restores this file.
        -->
        <service
            android:name=".notify.PaymentNotificationListenerService"
            android:label="Trackerz spend capture"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
            android:exported="false">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>
</manifest>
